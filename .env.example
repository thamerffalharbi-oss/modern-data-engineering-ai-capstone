# SDAIA Capstone — Environment variable template
# Copy to .env and fill in values. Never commit .env.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_READINGS=capstone.readings
KAFKA_TOPIC_DLQ=capstone.dlq
KAFKA_CONSUMER_GROUP=capstone-ingest

# --- Spark / Delta ---
CAPSTONE_SPARK_MASTER=local[2]

# --- Quality gate ---
CAPSTONE_MAX_ANOMALY_RATE=0.60
CAPSTONE_ANOMALY_THRESHOLD_C=85.0

# --- RAG ---
CAPSTONE_EMBED_MODEL=all-MiniLM-L6-v2
CAPSTONE_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# HF_HOME points to the model cache directory (reuse day03's cache)
# HF_HOME=../day03_rag_pipeline/.hf_cache

# --- RAG LLM backend (optional) ---
# CAPSTONE_LLM_BACKEND=extractive   # default: local, no API key needed
# CAPSTONE_LLM_BACKEND=openai       # requires OPENAI_API_KEY
# OPENAI_API_KEY=                   # never commit real keys
# OPENAI_BASE_URL=                  # optional: custom endpoint
# CAPSTONE_LLM_MODEL=gpt-4o-mini

# --- OpenLineage ---
OPENLINEAGE_NAMESPACE=sdaia-capstone
# CAPSTONE_LINEAGE_TRANSPORT=file   # default: FileTransport (no external collector)
# CAPSTONE_LINEAGE_TRANSPORT=http   # requires OPENLINEAGE_URL
# OPENLINEAGE_URL=                  # e.g. http://localhost:5000

# --- Airflow ---
# CAPSTONE_PYTHON=/path/to/capstone/.venv311/Scripts/python.exe
# CAPSTONE_SCENARIO=healthy         # or "overheat" for failure-path testing

# --- Data paths (defaults point to capstone/data/) ---
# CAPSTONE_DATA_DIR=capstone/data
# CAPSTONE_EVIDENCE_DIR=capstone/evidence
